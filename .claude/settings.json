{
  "permissions": {
    "allow": [
      "Bash(python tests/*)",
      "Bash(py tests/*)",
      "Bash(python -m py_compile *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(pip install *)",
      "Bash(python outils/banc_essai.py*)",
      "Bash(python -m ruff *)",
      "Bash(python -m vulture *)",
      "Bash(py-spy *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git reset --hard*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/verifier_syntaxe.py"
          }
        ]
      }
    ]
  }
}
